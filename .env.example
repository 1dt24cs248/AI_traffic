# ---- Database ----
POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=traffic_flow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://traffic_user:change_me@localhost:5432/traffic_flow_db

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Routing (OSRM) ----
# Public OSRM is used by default. Override to use a self-hosted instance.
OSRM_BASE_URL=https://router.project-osrm.org

# ---- Geocoding (Nominatim) ----
# OSM policy: identify your application in the User-Agent header.
GEOCODING_USER_AGENT=AI-Traffic-Flow-Predictor/1.0 (college project; your-email@example.com)

# ---- Weather (Open-Meteo) ----
# No API key required for non-commercial use. Override for self-hosted.
WEATHER_BASE_URL=https://api.open-meteo.com/v1
